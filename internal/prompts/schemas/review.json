{
  "type": "object",
  "additionalProperties": false,
  "required": ["passed", "score", "hard_issues", "quality_issues", "revision_instructions"],
  "properties": {
    "passed": {"type": "boolean"},
    "score": {"type": "integer", "minimum": 0, "maximum": 100},
    "hard_issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}},
    "quality_issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}},
    "revision_instructions": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "issue": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "description", "evidence", "suggestion"],
      "properties": {
        "code": {"type": "string"}, "description": {"type": "string"},
        "evidence": {"type": "string"}, "suggestion": {"type": "string"}
      }
    }
  }
}
