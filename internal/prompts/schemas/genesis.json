{
  "type": "object",
  "additionalProperties": false,
  "required": ["bible", "outline", "initial_state"],
  "properties": {
    "bible": {"$ref": "#/$defs/bible"},
    "outline": {"$ref": "#/$defs/outline"},
    "initial_state": {"$ref": "#/$defs/initial_state"}
  },
  "$defs": {
    "strings": {"type": "array", "items": {"type": "string"}},
    "target_reader": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "reading_history", "craves", "forgives", "drops_when", "binge_triggers"],
      "properties": {
        "name": {"type": "string"}, "reading_history": {"type": "string"},
        "craves": {"$ref": "#/$defs/strings"}, "forgives": {"$ref": "#/$defs/strings"},
        "drops_when": {"$ref": "#/$defs/strings"}, "binge_triggers": {"$ref": "#/$defs/strings"}
      }
    },
    "promise": {
      "type": "object", "additionalProperties": false,
      "required": ["primary_pleasure", "supporting_pleasures", "must_deliver", "must_not_become"],
      "properties": {
        "primary_pleasure": {"type": "string"},
        "supporting_pleasures": {"$ref": "#/$defs/strings"},
        "must_deliver": {"$ref": "#/$defs/strings"},
        "must_not_become": {"$ref": "#/$defs/strings"}
      }
    },
    "style": {
      "type": "object", "additionalProperties": false,
      "required": ["point_of_view", "tone", "prose_rules"],
      "properties": {
        "point_of_view": {"type": "string"}, "tone": {"type": "string"},
        "prose_rules": {"$ref": "#/$defs/strings"}
      }
    },
    "character": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "role", "trait", "desire", "weakness", "secret"],
      "properties": {
        "id": {"type": "string"}, "name": {"type": "string"}, "role": {"type": "string"},
        "trait": {"type": "string"}, "desire": {"type": "string"},
        "weakness": {"type": "string"}, "secret": {"type": "string"}
      }
    },
    "bible": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "premise", "story_spine", "target_reader", "narrative_promise", "characters", "world_rules", "stable_facts", "ending_direction", "style"],
      "properties": {
        "title": {"type": "string"}, "premise": {"type": "string"}, "story_spine": {"type": "string"},
        "target_reader": {"$ref": "#/$defs/target_reader"},
        "narrative_promise": {"$ref": "#/$defs/promise"},
        "characters": {"type": "array", "items": {"$ref": "#/$defs/character"}},
        "world_rules": {"$ref": "#/$defs/strings"}, "stable_facts": {"$ref": "#/$defs/strings"},
        "ending_direction": {"type": "string"}, "style": {"$ref": "#/$defs/style"}
      }
    },
    "arc": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "purpose", "completion_signals"],
      "properties": {
        "name": {"type": "string"}, "purpose": {"type": "string"},
        "completion_signals": {"$ref": "#/$defs/strings"}
      }
    },
    "track": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "role", "direction", "status"],
      "properties": {
        "id": {"type": "string"}, "name": {"type": "string"}, "role": {"type": "string"},
        "direction": {"type": "string"}, "status": {"type": "string", "enum": ["ongoing", "completed"]}
      }
    },
    "outline": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "current_arc", "tracks", "future_directions"],
      "properties": {
        "version": {"type": "integer"}, "current_arc": {"$ref": "#/$defs/arc"},
        "tracks": {"type": "array", "items": {"$ref": "#/$defs/track"}},
        "future_directions": {"$ref": "#/$defs/strings"}
      }
    },
    "character_state": {
      "type": "object", "additionalProperties": false,
      "required": ["character_id", "state"],
      "properties": {"character_id": {"type": "string"}, "state": {"type": "string"}}
    },
    "durable_state": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {"id": {"type": "string"}, "description": {"type": "string"}}
    },
    "track_progress": {
      "type": "object", "additionalProperties": false,
      "required": ["track_id", "progress"],
      "properties": {"track_id": {"type": "string"}, "progress": {"type": "string"}}
    },
    "initial_state": {
      "type": "object", "additionalProperties": false,
      "required": ["character_states", "durable_states", "track_progress"],
      "properties": {
        "character_states": {"type": "array", "items": {"$ref": "#/$defs/character_state"}},
        "durable_states": {"type": "array", "items": {"$ref": "#/$defs/durable_state"}},
        "track_progress": {"type": "array", "items": {"$ref": "#/$defs/track_progress"}}
      }
    }
  }
}
