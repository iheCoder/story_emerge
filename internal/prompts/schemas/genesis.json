{
  "type": "object", "additionalProperties": false,
  "required": ["bible", "outline", "initial_state", "initial_reader_state"],
  "properties": {
    "bible": {"$ref": "#/$defs/bible"},
    "outline": {"$ref": "#/$defs/outline"},
    "initial_state": {"$ref": "#/$defs/initial_state"},
    "initial_reader_state": {"$ref": "#/$defs/reader_state"}
  },
  "$defs": {
    "string_array": {"type": "array", "items": {"type": "string"}},
    "target_reader": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "reading_history", "craves", "forgives", "drops_when", "binge_triggers", "fit_with_story"],
      "properties": {
        "name": {"type": "string"}, "reading_history": {"type": "string"},
        "craves": {"$ref": "#/$defs/string_array"}, "forgives": {"$ref": "#/$defs/string_array"},
        "drops_when": {"$ref": "#/$defs/string_array"}, "binge_triggers": {"$ref": "#/$defs/string_array"},
        "fit_with_story": {"type": "string"}
      }
    },
    "promise": {
      "type": "object", "additionalProperties": false,
      "required": ["primary_pleasure", "supporting_pleasures", "must_deliver", "must_not_become"],
      "properties": {
        "primary_pleasure": {"type": "string"}, "supporting_pleasures": {"$ref": "#/$defs/string_array"},
        "must_deliver": {"$ref": "#/$defs/string_array"}, "must_not_become": {"$ref": "#/$defs/string_array"}
      }
    },
    "style": {
      "type": "object", "additionalProperties": false, "required": ["point_of_view", "tone", "prose_rules"],
      "properties": {"point_of_view": {"type": "string"}, "tone": {"type": "string"}, "prose_rules": {"$ref": "#/$defs/string_array"}}
    },
    "character": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "role", "trait", "desire", "weakness", "secret"],
      "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "role": {"type": "string"}, "trait": {"type": "string"}, "desire": {"type": "string"}, "weakness": {"type": "string"}, "secret": {"type": "string"}}
    },
    "bible": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "genre", "logline", "target_reader", "narrative_promise", "ending_direction", "protagonist_id", "style", "characters", "canon_rules", "recurring_motifs"],
      "properties": {
        "title": {"type": "string"}, "genre": {"type": "string"}, "logline": {"type": "string"},
        "target_reader": {"$ref": "#/$defs/target_reader"}, "narrative_promise": {"$ref": "#/$defs/promise"},
        "ending_direction": {"type": "string"}, "protagonist_id": {"type": "string"}, "style": {"$ref": "#/$defs/style"},
        "characters": {"type": "array", "items": {"$ref": "#/$defs/character"}},
        "canon_rules": {"$ref": "#/$defs/string_array"}, "recurring_motifs": {"$ref": "#/$defs/string_array"}
      }
    },
    "movement": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "dramatic_pressure", "intended_change", "expected_reward", "completion_signals"],
      "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "dramatic_pressure": {"type": "string"}, "intended_change": {"type": "string"}, "expected_reward": {"type": "string"}, "completion_signals": {"$ref": "#/$defs/string_array"}}
    },
    "outline": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "core_conflict", "protagonist_drive", "current_movement_id", "movements"],
	  "properties": {"version": {"type": "integer"}, "core_conflict": {"type": "string"}, "protagonist_drive": {"type": "string"}, "current_movement_id": {"type": "string"}, "movements": {"type": "array", "items": {"$ref": "#/$defs/movement"}}}
    },
    "knowledge": {
      "type": "object", "additionalProperties": false, "required": ["fact_id", "belief", "confidence"],
      "properties": {"fact_id": {"type": "string"}, "belief": {"type": "string"}, "confidence": {"type": "integer", "minimum": 0, "maximum": 100}}
    },
    "relationship": {
      "type": "object", "additionalProperties": false, "required": ["target_id", "stance", "trust", "tension", "note"],
      "properties": {"target_id": {"type": "string"}, "stance": {"type": "string"}, "trust": {"type": "integer", "minimum": 0, "maximum": 100}, "tension": {"type": "integer", "minimum": 0, "maximum": 100}, "note": {"type": "string"}}
    },
    "character_state": {
      "type": "object", "additionalProperties": false, "required": ["character_id", "goal", "emotion", "location", "knowledge", "relationships"],
      "properties": {"character_id": {"type": "string"}, "goal": {"type": "string"}, "emotion": {"type": "string"}, "location": {"type": "string"}, "knowledge": {"type": "array", "items": {"$ref": "#/$defs/knowledge"}}, "relationships": {"type": "array", "items": {"$ref": "#/$defs/relationship"}}}
    },
    "fact": {
      "type": "object", "additionalProperties": false, "required": ["id", "description", "visibility", "since_chapter"],
      "properties": {"id": {"type": "string"}, "description": {"type": "string"}, "visibility": {"type": "string"}, "since_chapter": {"type": "integer"}}
    },
    "thread": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "kind", "status", "progress", "opened_chapter", "last_touched_chapter"],
      "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "kind": {"type": "string"}, "status": {"type": "string", "enum": ["active", "dormant", "resolved"]}, "progress": {"type": "string"}, "opened_chapter": {"type": "integer"}, "last_touched_chapter": {"type": "integer"}}
    },
    "initial_state": {
      "type": "object", "additionalProperties": false, "required": ["characters", "facts", "threads"],
      "properties": {"characters": {"type": "array", "items": {"$ref": "#/$defs/character_state"}}, "facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}}, "threads": {"type": "array", "items": {"$ref": "#/$defs/thread"}}}
    },
    "reader_state": {
      "type": "object", "additionalProperties": false,
      "required": ["chapter", "cares_about", "understands_goal", "wants_next", "current_feeling", "received_payoff", "confused_by", "losing_patience_with", "continue_reason", "suggested_action"],
      "properties": {
        "chapter": {"type": "integer"}, "cares_about": {"$ref": "#/$defs/string_array"}, "understands_goal": {"type": "string"},
        "wants_next": {"$ref": "#/$defs/string_array"}, "current_feeling": {"type": "string"}, "received_payoff": {"$ref": "#/$defs/string_array"},
        "confused_by": {"$ref": "#/$defs/string_array"}, "losing_patience_with": {"$ref": "#/$defs/string_array"},
        "continue_reason": {"type": "string"}, "suggested_action": {"type": "string", "enum": ["continue", "adjust", "replan"]}
      }
    }
  }
}
