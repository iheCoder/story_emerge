{
  "type": "object", "additionalProperties": false,
  "required": ["chapter", "summary", "new_facts", "character_states", "thread_states", "new_threads", "timeline_events", "outline_progress", "story_status"],
  "properties": {
    "chapter": {"type": "integer"},
    "summary": {"type": "object", "additionalProperties": false, "required": ["number", "title", "summary", "key_changes"],
      "properties": {"number": {"type": "integer"}, "title": {"type": "string"}, "summary": {"type": "string"}, "key_changes": {"type": "array", "items": {"type": "string"}}}},
    "new_facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
    "character_states": {"type": "array", "items": {"$ref": "#/$defs/character_state"}},
    "thread_states": {"type": "array", "items": {"$ref": "#/$defs/thread"}},
    "new_threads": {"type": "array", "items": {"$ref": "#/$defs/thread"}},
    "timeline_events": {"type": "array", "items": {"$ref": "#/$defs/event"}},
    "outline_progress": {"type": "object", "additionalProperties": false, "required": ["current_movement_id", "status", "evidence"],
      "properties": {"current_movement_id": {"type": "string"}, "status": {"type": "string", "enum": ["ongoing", "completed", "blocked"]}, "evidence": {"type": "string"}}},
    "story_status": {"type": "string", "enum": ["ongoing", "ending", "completed"]}
  },
  "$defs": {
    "knowledge": {"type": "object", "additionalProperties": false, "required": ["fact_id", "belief", "confidence"],
      "properties": {"fact_id": {"type": "string"}, "belief": {"type": "string"}, "confidence": {"type": "integer", "minimum": 0, "maximum": 100}}},
    "relationship": {"type": "object", "additionalProperties": false, "required": ["target_id", "stance", "trust", "tension", "note"],
      "properties": {"target_id": {"type": "string"}, "stance": {"type": "string"}, "trust": {"type": "integer", "minimum": 0, "maximum": 100}, "tension": {"type": "integer", "minimum": 0, "maximum": 100}, "note": {"type": "string"}}},
    "character_state": {"type": "object", "additionalProperties": false, "required": ["character_id", "goal", "emotion", "location", "knowledge", "relationships"],
      "properties": {"character_id": {"type": "string"}, "goal": {"type": "string"}, "emotion": {"type": "string"}, "location": {"type": "string"}, "knowledge": {"type": "array", "items": {"$ref": "#/$defs/knowledge"}}, "relationships": {"type": "array", "items": {"$ref": "#/$defs/relationship"}}}},
    "fact": {"type": "object", "additionalProperties": false, "required": ["id", "description", "visibility", "since_chapter"],
      "properties": {"id": {"type": "string"}, "description": {"type": "string"}, "visibility": {"type": "string"}, "since_chapter": {"type": "integer"}}},
    "thread": {"type": "object", "additionalProperties": false, "required": ["id", "name", "kind", "status", "progress", "opened_chapter", "last_touched_chapter"],
      "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "kind": {"type": "string"}, "status": {"type": "string", "enum": ["active", "dormant", "resolved"]}, "progress": {"type": "string"}, "opened_chapter": {"type": "integer"}, "last_touched_chapter": {"type": "integer"}}},
    "event": {"type": "object", "additionalProperties": false, "required": ["chapter", "description", "participants"],
      "properties": {"chapter": {"type": "integer"}, "description": {"type": "string"}, "participants": {"type": "array", "items": {"type": "string"}}}}
  }
}
