{
  "type": "object",
  "additionalProperties": false,
  "required": ["story_update", "reader_visible_summary"],
  "properties": {
    "story_update": {"$ref": "#/$defs/update"},
    "reader_visible_summary": {"$ref": "#/$defs/summary"}
  },
  "$defs": {
    "character_change": {
      "type": "object", "additionalProperties": false,
      "required": ["character_id", "state"],
      "properties": {"character_id": {"type": "string"}, "state": {"type": "string"}}
    },
    "situation_change": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "id", "description"],
      "properties": {
        "operation": {"type": "string", "enum": ["upsert", "remove"]},
        "id": {"type": "string"}, "description": {"type": "string"}
      }
    },
    "update": {
      "type": "object", "additionalProperties": false,
      "required": ["chapter", "character_changes", "situation_state_changes", "story_status"],
      "properties": {
        "chapter": {"type": "integer"},
        "character_changes": {"type": "array", "items": {"$ref": "#/$defs/character_change"}},
        "situation_state_changes": {"type": "array", "items": {"$ref": "#/$defs/situation_change"}},
        "story_status": {"type": "string", "enum": ["ongoing", "ending", "completed"]}
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["number", "title", "summary", "key_changes"],
      "properties": {
        "number": {"type": "integer"}, "title": {"type": "string"}, "summary": {"type": "string"},
        "key_changes": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
