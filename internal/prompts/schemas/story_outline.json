{
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "current_arc", "tracks"],
  "properties": {
    "version": {"type": "integer"},
    "current_arc": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "purpose"],
      "properties": {
        "name": {"type": "string"}, "purpose": {"type": "string"}
      }
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "direction", "status"],
        "properties": {
          "id": {"type": "string"}, "name": {"type": "string"},
          "direction": {"type": "string"}, "status": {"type": "string", "enum": ["ongoing", "completed"]}
        }
      }
    }
  }
}
