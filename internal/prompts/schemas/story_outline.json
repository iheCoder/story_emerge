{
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "current_arc", "tracks", "future_directions"],
  "properties": {
    "version": {"type": "integer"},
    "current_arc": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "purpose", "completion_signals"],
      "properties": {
        "name": {"type": "string"}, "purpose": {"type": "string"},
        "completion_signals": {"type": "array", "items": {"type": "string"}}
      }
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "role", "direction", "status"],
        "properties": {
          "id": {"type": "string"}, "name": {"type": "string"}, "role": {"type": "string"},
          "direction": {"type": "string"}, "status": {"type": "string", "enum": ["ongoing", "completed"]}
        }
      }
    },
    "future_directions": {"type": "array", "items": {"type": "string"}}
  }
}
